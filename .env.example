# ============================================================================
# Luxembourg property monitor — environment
# Copy to `.env` (it is git-ignored). Everything here is OPTIONAL: the monitor
# runs with no configuration at all.
#
# No external API keys are required:
#   - commute times use an offline estimate      (no Google Maps key)
#   - description analysis uses offline heuristics (no LLM / Anthropic key)
# ============================================================================

# Optional: override the SQLite database location (default: data/monitor.db).
# Use an absolute path (note the four slashes for sqlite:////abs/path).
# LUX_MONITOR_DB_URL=sqlite:////home/you/Immo/data/monitor.db

# ---- Email alerts: NOT IMPLEMENTED YET ----
# When notifications are added, set these (Gmail App Password, not your login):
# GMAIL_ADDRESS=your-email@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# RECIPIENT_EMAIL=your-email@gmail.com

# ---- Legacy DE/FR stack only (unused by the Luxembourg monitor) ----
# TWOCAPTCHA_API_KEY=
# PROXY_USER=
# PROXY_PASS=
